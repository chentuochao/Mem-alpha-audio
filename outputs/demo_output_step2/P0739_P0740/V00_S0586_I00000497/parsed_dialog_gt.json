[
  {
    "speaker": "P0740",
    "start": 0,
    "end": 2.288000000000011,
    "text": "house is big and spacious."
  },
  {
    "speaker": "P0739",
    "start": 4.569999999999936,
    "end": 6.171000000000049,
    "text": "How spacious is it?"
  },
  {
    "speaker": "P0739",
    "start": 15.516000000000076,
    "end": 17.998000000000047,
    "text": "I'm thinking about dinner options."
  },
  {
    "speaker": "P0740",
    "start": 19.09699999999998,
    "end": 20.857999999999947,
    "text": "What type of dinner options?"
  },
  {
    "speaker": "P0739",
    "start": 24.922000000000025,
    "end": 30.7650000000001,
    "text": "Everything with the desserts. I need to know like where we should eat. Should we get pizza?"
  },
  {
    "speaker": "P0740",
    "start": 36.85200000000009,
    "end": 39.37300000000005,
    "text": "Sports cars are fast and powerful."
  },
  {
    "speaker": "P0739",
    "start": 40.16300000000001,
    "end": 42.92399999999998,
    "text": "Oh yeah, you don't like to live life in the fast lane?"
  },
  {
    "speaker": "P0740",
    "start": 43.516000000000076,
    "end": 44.215999999999894,
    "text": "I'm actually scared."
  },
  {
    "speaker": "P0739",
    "start": 49.80700000000006,
    "end": 56.06899999999996,
    "text": "I'm feeling confused about a lot of things right now."
  },
  {
    "speaker": "P0740",
    "start": 52.68100000000004,
    "end": 53.240999999999985,
    "text": "About what?"
  },
  {
    "speaker": "P0740",
    "start": 58.02299999999991,
    "end": 58.92399999999998,
    "text": "Anything."
  },
  {
    "speaker": "P0740",
    "start": 64.84699999999998,
    "end": 66.48800000000006,
    "text": "It is hot outside today."
  },
  {
    "speaker": "P0739",
    "start": 67.13300000000004,
    "end": 69.394,
    "text": "Yeah, and I'm wearing a sweater."
  },
  {
    "speaker": "P0740",
    "start": 71.23000000000002,
    "end": 71.8710000000001,
    "text": "I'm sweating."
  },
  {
    "speaker": "P0739",
    "start": 76.83500000000004,
    "end": 79.13599999999997,
    "text": "I'm dancing to my favorite song."
  },
  {
    "speaker": "P0740",
    "start": 79.93599999999992,
    "end": 80.79700000000003,
    "text": "Dancing?"
  },
  {
    "speaker": "P0739",
    "start": 80.85699999999997,
    "end": 81.59699999999998,
    "text": "Dancing."
  },
  {
    "speaker": "P0740",
    "start": 87.44100000000003,
    "end": 90.7840000000001,
    "text": "I feel sad when I think about my lost pet."
  },
  {
    "speaker": "P0739",
    "start": 92.6210000000001,
    "end": 94.18200000000002,
    "text": "Oh, that's very deep."
  },
  {
    "speaker": "P0740",
    "start": 95.24700000000007,
    "end": 95.44699999999989,
    "text": "Yeah."
  },
  {
    "speaker": "P0739",
    "start": 100.06500000000005,
    "end": 102.22499999999991,
    "text": "I love spending time with my family."
  },
  {
    "speaker": "P0740",
    "start": 102.93200000000002,
    "end": 105.09400000000005,
    "text": "I love spending time with my family too."
  },
  {
    "speaker": "P0740",
    "start": 110.77800000000002,
    "end": 113.11999999999989,
    "text": "I was surprised by the news actually."
  },
  {
    "speaker": "P0739",
    "start": 113.7349999999999,
    "end": 114.33600000000001,
    "text": "Which part?"
  },
  {
    "speaker": "P0740",
    "start": 118.18299999999999,
    "end": 119.84500000000003,
    "text": "Do I keep going? Okay."
  },
  {
    "speaker": "P0740",
    "start": 126.63000000000011,
    "end": 126.84999999999991,
    "text": "Okay."
  },
  {
    "speaker": "P0739",
    "start": 131.45299999999997,
    "end": 133.17499999999995,
    "text": "Can you just stop talking?"
  },
  {
    "speaker": "P0740",
    "start": 134.48299999999995,
    "end": 138.22900000000004,
    "text": "I haven't even talked at all right now."
  },
  {
    "speaker": "P0740",
    "start": 144.48000000000002,
    "end": 147.4849999999999,
    "text": "The road is flat and even."
  },
  {
    "speaker": "P0739",
    "start": 149.01700000000005,
    "end": 149.57799999999997,
    "text": "Interesting."
  },
  {
    "speaker": "P0739",
    "start": 154.7639999999999,
    "end": 156.14599999999996,
    "text": "We did it, victory!"
  },
  {
    "speaker": "P0740",
    "start": 162.74299999999994,
    "end": 164.42399999999998,
    "text": "I am afraid of heights."
  },
  {
    "speaker": "P0739",
    "start": 165.81899999999996,
    "end": 166.70000000000005,
    "text": "I know you are."
  },
  {
    "speaker": "P0739",
    "start": 175.84500000000003,
    "end": 179.16699999999992,
    "text": "The earth is a round planet."
  },
  {
    "speaker": "P0740",
    "start": 180.11200000000008,
    "end": 181.97299999999996,
    "text": "Some people think it's flat."
  },
  {
    "speaker": "P0739",
    "start": 182.71000000000004,
    "end": 183.95100000000002,
    "text": "Some people don't know."
  },
  {
    "speaker": "P0740",
    "start": 189.03700000000003,
    "end": 191.1780000000001,
    "text": "I was agitated about the delay."
  },
  {
    "speaker": "P0739",
    "start": 192.85700000000003,
    "end": 194.03700000000003,
    "text": "How agitated were you?"
  },
  {
    "speaker": "P0739",
    "start": 201.00199999999995,
    "end": 203.60400000000004,
    "text": "He's reluctant to try new food."
  },
  {
    "speaker": "P0740",
    "start": 204.68499999999995,
    "end": 206.346,
    "text": "Yeah, he's kind of a picky eater."
  },
  {
    "speaker": "P0739",
    "start": 207.0530000000001,
    "end": 207.5329999999999,
    "text": "I agree."
  },
  {
    "speaker": "P0740",
    "start": 214.67200000000003,
    "end": 218.95499999999993,
    "text": "The chef is chopping vegetables for dinner."
  },
  {
    "speaker": "P0739",
    "start": 219.9770000000001,
    "end": 221.35799999999995,
    "text": "I love to watch when they do that."
  },
  {
    "speaker": "P0739",
    "start": 226.3989999999999,
    "end": 228.76,
    "text": "I am satisfied with the service today."
  },
  {
    "speaker": "P0740",
    "start": 229.48199999999997,
    "end": 230.94299999999998,
    "text": "I am satisfied as well."
  },
  {
    "speaker": "P0740",
    "start": 236.7840000000001,
    "end": 238.98599999999988,
    "text": "I am annoyed by the constant noise."
  },
  {
    "speaker": "P0739",
    "start": 240.69900000000007,
    "end": 241.45899999999983,
    "text": "Me too."
  },
  {
    "speaker": "P0739",
    "start": 248.20200000000023,
    "end": 251.02300000000014,
    "text": "The child is scared of the dark."
  },
  {
    "speaker": "P0740",
    "start": 252.05600000000004,
    "end": 252.97699999999986,
    "text": "Let me turn off the lights."
  },
  {
    "speaker": "P0739",
    "start": 254.2449999999999,
    "end": 254.78499999999985,
    "text": "That's mean."
  },
  {
    "speaker": "P0740",
    "start": 261.46399999999994,
    "end": 263.9659999999999,
    "text": "I am counting the number of people in the room."
  },
  {
    "speaker": "P0739",
    "start": 265.3499999999999,
    "end": 266.27,
    "text": "How many do you count?"
  },
  {
    "speaker": "P0739",
    "start": 274.09900000000016,
    "end": 275.7049999999999,
    "text": "That is the wrong answer."
  },
  {
    "speaker": "P0740",
    "start": 277.09799999999996,
    "end": 279.41899999999987,
    "text": "I think it's the right answer."
  }
]