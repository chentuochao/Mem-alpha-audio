  {
    "speaker": "P5125",
    "start": 5.25,
    "end": 7.13100000000004,
    "text": "She sat beside her friend. All right."
  },
  {
    "speaker": "P5124",
    "start": 18.5,
    "end": 19.480999999999995,
    "text": "The road is curved."
  },
  {
    "speaker": "P5125",
    "start": 27.76299999999992,
    "end": 28.52299999999991,
    "text": "Walk straight ahead."
  },
  {
    "speaker": "P5124",
    "start": 29.563000000000102,
    "end": 34.74499999999989,
    "text": "Thank you for telling me that. The ant is tiny."
  },
  {
    "speaker": "P5125",
    "start": 36.229000000000084,
    "end": 36.80899999999997,
    "text": "I hope so."
  },
  {
    "speaker": "P5125",
    "start": 43.57400000000007,
    "end": 44.77500000000009,
    "text": "The shirt is medium sized."
  },
  {
    "speaker": "P5124",
    "start": 46.1099999999999,
    "end": 46.430000000000064,
    "text": "Perfect."
  },
  {
    "speaker": "P5124",
    "start": 55.855999999999995,
    "end": 57.19699999999989,
    "text": "There are a few apples left."
  },
  {
    "speaker": "P5125",
    "start": 59.94800000000009,
    "end": 65.55199999999991,
    "text": "Bummer. This shelf is out of reach."
  },
  {
    "speaker": "P5124",
    "start": 67.64300000000003,
    "end": 68.14300000000003,
    "text": "I can get that."
  },
  {
    "speaker": "P5124",
    "start": 73.62599999999998,
    "end": 74.54700000000003,
    "text": "There are three cars."
  },
  {
    "speaker": "P5125",
    "start": 77.94199999999982,
    "end": 84.86700000000019,
    "text": "There's only two of us. She has two dogs."
  },
  {
    "speaker": "P5124",
    "start": 88.11499999999978,
    "end": 91.33800000000019,
    "text": "Bark bark. The lemon is sour."
  },
  {
    "speaker": "P5125",
    "start": 97.67000000000007,
    "end": 98.67099999999982,
    "text": "Coffee is bitter."
  },
  {
    "speaker": "P5124",
    "start": 99.28600000000006,
    "end": 100.70699999999988,
    "text": "I like coffee regardless."
  },
  {
    "speaker": "P5125",
    "start": 102.77399999999989,
    "end": 103.27399999999989,
    "text": "Add sugar."
  },
  {
    "speaker": "P5124",
    "start": 107.51800000000003,
    "end": 109.90000000000009,
    "text": "The school is close to the library."
  },
  {
    "speaker": "P5125",
    "start": 112.48100000000022,
    "end": 118.52500000000009,
    "text": "Excellent. The road is at the end of the street."
  },
  {
    "speaker": "P5124",
    "start": 120.01000000000022,
    "end": 120.31100000000015,
    "text": "Got it?"
  },
  {
    "speaker": "P5124",
    "start": 128.45899999999983,
    "end": 129.42000000000007,
    "text": "He's lifting the weights."
  },
  {
    "speaker": "P5125",
    "start": 132.38500000000022,
    "end": 136.52599999999984,
    "text": "It's strong. He's pushing the cart."
  },
  {
    "speaker": "P5124",
    "start": 138.17000000000007,
    "end": 138.48999999999978,
    "text": "Shopping."
  },
  {
    "speaker": "P5124",
    "start": 146.3739999999998,
    "end": 147.2550000000001,
    "text": "She's throwing the ball."
  },
  {
    "speaker": "P5125",
    "start": 148.5880000000002,
    "end": 154.86900000000014,
    "text": "Basket. She's pulling the rope."
  },
  {
    "speaker": "P5124",
    "start": 157.0999999999999,
    "end": 158.98100000000022,
    "text": "Like me, he is lost in nostalgia."
  },
  {
    "speaker": "P5125",
    "start": 164.13999999999987,
    "end": 165.72899999999981,
    "text": "She's smiling with contentment."
  },
  {
    "speaker": "P5124",
    "start": 167.26999999999998,
    "end": 167.971,
    "text": "Reminds me of myself. Is"
