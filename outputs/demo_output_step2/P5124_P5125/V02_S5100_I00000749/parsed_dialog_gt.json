[
  {
    "speaker": "P5124",
    "start": 1.178000000000111,
    "end": 3.4200000000000728,
    "text": "The cat hid below the table..."
  },
  {
    "speaker": "P5125",
    "start": 5.442000000000007,
    "end": 13.347999999999956,
    "text": "They like to do that. The bird flew above my head."
  },
  {
    "speaker": "P5124",
    "start": 15.713999999999942,
    "end": 17.375,
    "text": "Well, birds do fly, it's true."
  },
  {
    "speaker": "P5124",
    "start": 22.839999999999918,
    "end": 24.18100000000004,
    "text": "She was among the crowd."
  },
  {
    "speaker": "P5125",
    "start": 26.157999999999948,
    "end": 33.18299999999999,
    "text": "Oh, that's good. The ball is between the shoes."
  },
  {
    "speaker": "P5124",
    "start": 35.37099999999991,
    "end": 36.27099999999996,
    "text": "Were you playing soccer?"
  },
  {
    "speaker": "P5124",
    "start": 41.97600000000011,
    "end": 42.99700000000007,
    "text": "The pencil is short."
  },
  {
    "speaker": "P5125",
    "start": 45.57999999999993,
    "end": 46.42000000000007,
    "text": "You need a new one then."
  },
  {
    "speaker": "P5125",
    "start": 51.58200000000011,
    "end": 52.74199999999996,
    "text": "Building's tall."
  },
  {
    "speaker": "P5124",
    "start": 54.340999999999894,
    "end": 56.30199999999991,
    "text": "Most buildings are skyscraper."
  },
  {
    "speaker": "P5124",
    "start": 62.46399999999994,
    "end": 63.56400000000008,
    "text": "The book is within reach."
  },
  {
    "speaker": "P5125",
    "start": 65.4659999999999,
    "end": 72.16799999999989,
    "text": "That's convenient. The star is distant."
  },
  {
    "speaker": "P5124",
    "start": 73.02800000000002,
    "end": 73.60799999999995,
    "text": "I love the stars."
  },
  {
    "speaker": "P5124",
    "start": 79.02199999999993,
    "end": 80.58300000000008,
    "text": "I have one apple."
  },
  {
    "speaker": "P5125",
    "start": 82.51199999999994,
    "end": 89.71399999999994,
    "text": "Well, then I guess you have to share. Use less sugar."
  },
  {
    "speaker": "P5124",
    "start": 91.04600000000005,
    "end": 93.38699999999994,
    "text": "That can be healthier."
  },
  {
    "speaker": "P5124",
    "start": 99.58899999999994,
    "end": 100.84899999999993,
    "text": "The conversation was hushed."
  },
  {
    "speaker": "P5125",
    "start": 104.35699999999997,
    "end": 109.27800000000002,
    "text": "Quiet. The street's noisy."
  },
  {
    "speaker": "P5124",
    "start": 111.32799999999997,
    "end": 112.86999999999989,
    "text": "During traffic, yeah, it gets like that."
  },
  {
    "speaker": "P5124",
    "start": 118.33400000000006,
    "end": 122.79700000000003,
    "text": "The sauce is tangy. I do."
  },
  {
    "speaker": "P5125",
    "start": 121.48700000000008,
    "end": 122.02700000000004,
    "text": "I like that though."
  },
  {
    "speaker": "P5125",
    "start": 124.84899999999993,
    "end": 126.1099999999999,
    "text": "The curry is spicy."
  },
  {
    "speaker": "P5124",
    "start": 126.25999999999999,
    "end": 134.64699999999993,
    "text": "I love curry. I love food. The bird is gliding through the sky."
  },
  {
    "speaker": "P5125",
    "start": 136.25700000000006,
    "end": 143.18100000000004,
    "text": "I wish I could fly. The baby is crawling on the floor."
  },
  {
    "speaker": "P5124",
    "start": 144.12400000000002,
    "end": 150.827,
    "text": "Oh, how cute. The ball is bouncing on the ground."
  },
  {
    "speaker": "P5125",
    "start": 159.0999999999999,
    "end": 160.1010000000001,
    "text": "He's climbing the ladder."
  },
  {
    "speaker": "P5124",
    "start": 161.031,
    "end": 162.0709999999999,
    "text": "That's what that is for."
  },
  {
    "speaker": "P5124",
    "start": 169.09400000000005,
    "end": 170.95499999999993,
    "text": "Her creativity is inspiring."
  },
  {
    "speaker": "P5125",
    "start": 172.52700000000004,
    "end": 178.73000000000002,
    "text": "It's good to be inspired. He had a sudden realization"
  },
  {
    "speaker": "P5124",
    "start": 180.18399999999997,
    "end": 182,
    "text": "I get those sometimes. Nice."
  }
]