[
  {
    "speaker": "leonard_hofstadter",
    "start": 0.0,
    "end": 1.080000000000041,
    "text": "Wait for me."
  },
  {
    "speaker": "ramona_nowitzki",
    "start": 7.210000000000036,
    "end": 8.950000000000045,
    "text": "So have you worked out the neutrino issue?"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 9.43999999999994,
    "end": 14.629999999999995,
    "text": "Well, to paraphrase Mozart, all the subatomic particles are there, I just have to put them in the right order."
  },
  {
    "speaker": "ramona_nowitzki",
    "start": 14.720000000000027,
    "end": 15.700000000000045,
    "text": "You're so witty."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 16.66999999999996,
    "end": 17.25,
    "text": "Aren't I?"
  },
  {
    "speaker": "penny",
    "start": 22.289999999999964,
    "end": 24.840000000000032,
    "text": "Hey, guys, this package came for y..."
  },
  {
    "speaker": "ramona_nowitzki",
    "start": 28.659999999999968,
    "end": 30.00999999999999,
    "text": "Dr. Cooper is working."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 30.159999999999968,
    "end": 32.60000000000002,
    "text": "Yes, I'm close to a breakthrough. Ooh, it tickles"
  },
  {
    "speaker": "penny",
    "start": 32.960000000000036,
    "end": 33.32000000000005,
    "text": "Sorry."
  },
  {
    "speaker": "penny",
    "start": 40.90999999999997,
    "end": 43.450000000000045,
    "text": "Holy crap on a cracker."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 44.92999999999995,
    "end": 45.33000000000004,
    "text": "Hey, Penny."
  },
  {
    "speaker": "penny",
    "start": 45.47000000000003,
    "end": 47.39999999999998,
    "text": "Hi. You know, you probably don't want to go in there."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 48.08000000000004,
    "end": 48.960000000000036,
    "text": "Why? What are they doing?"
  },
  {
    "speaker": "penny",
    "start": 50.33000000000004,
    "end": 53.860000000000014,
    "text": "You know, the only way I could explain it would be in a therapist's office with dolls."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 59.809999999999945,
    "end": 60.16999999999996,
    "text": "Hoo-boy."
  }
]