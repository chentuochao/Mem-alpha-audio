  {
    "speaker": "leonard_hofstadter",
    "start": 25.369999999999997,
    "end": 26.559999999999995,
    "text": "Really? Define it."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 26.9,
    "end": 29.979999999999997,
    "text": "Kreplach, A hearty Klingon... dumpling."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 31.869999999999997,
    "end": 32.449999999999996,
