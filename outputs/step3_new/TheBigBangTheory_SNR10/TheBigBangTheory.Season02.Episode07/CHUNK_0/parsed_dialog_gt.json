  {
    "speaker": "raj_koothrappali",
    "start": 17.369999999999997,
    "end": 21.39,
    "text": "Hold on a second. Kreplach? That isn't Klingon, it's Yiddish for meat-filled dumpling."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 18.58,
    "end": 18.92,
    "text": "Yeah."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 21.43,
    "end": 25.279999999999994,
    "text": "Well, as it turns out, it's also a Klingon word."
