  {
    "speaker": "leonard_hofstadter",
    "start": 54.35999999999999,
    "end": 54.910000000000004,
    "text": "Aw!"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 55.52,
    "end": 57.46,
    "text": "What do you mean, aw? Like she didn't know we were nerds?"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 58.809999999999995,
