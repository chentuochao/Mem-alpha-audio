  {
    "speaker": "howard_wolowitz",
    "start": 41.64,
    "end": 42.9,
    "text": "Did you pay your cable bill?"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 50.23,
    "end": 53.26,
    "text": "Excuse me, Penny, but we're......playing Klingon Boggle."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 51.58,
    "end": 51.989999999999995,
    "text": "No,no, don't tell her."
