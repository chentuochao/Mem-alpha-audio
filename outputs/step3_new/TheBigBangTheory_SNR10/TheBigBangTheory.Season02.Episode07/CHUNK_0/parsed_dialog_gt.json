  {
    "speaker": "penny",
    "start": 36.019999999999996,
    "end": 37.239999999999995,
    "text": "Hey, guys, I need to use your TV."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 37.89,
    "end": 38.949999999999996,
    "text": "What's wrong with your TV?"
  },
  {
    "speaker": "penny",
    "start": 39.059999999999995,
    "end": 41.22,
    "text": "I don't know, it just died, I'm getting a bunch of static."
