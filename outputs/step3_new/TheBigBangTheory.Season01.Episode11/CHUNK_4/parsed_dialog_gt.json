[
  {
    "speaker": "sheldon_cooper",
    "start": 0.0,
    "end": 4.1200000000000045,
    "text": "Is that a dog? In the lab?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 1.4399999999999977,
    "end": 2.5399999999999636,
    "text": "Yes,"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 4.779999999999973,
    "end": 5.430000000000007,
    "text": "Yes,"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 7.039999999999964,
    "end": 15.859999999999957,
    "text": "they're training dogs to operate the centrifuge for when they need dogs to operate the centrifuge for blind scientists, I have to go."
  },
  {
    "speaker": "debbie_wolowitz",
    "start": 17.829999999999984,
    "end": 21.769999999999982,
    "text": "Howard, it's the phone."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 23.74000000000001,
    "end": 28.019999999999982,
    "text": "I know it's the phone, Ma, I hear the phone."
  },
  {
    "speaker": "debbie_wolowitz",
    "start": 28.680000000000007,
    "end": 30.96999999999997,
    "text": "Well who's calling at this ungodly hour?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 31.629999999999995,
    "end": 32.95999999999998,
    "text": "I don't know."
  },
  {
    "speaker": "debbie_wolowitz",
    "start": 33.56999999999999,
    "end": 36.94,
    "text": "Well ask them why they're calling at this ungodly hour."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 37.45999999999998,
    "end": 44.599999999999966,
    "text": "How can I ask them when I' m talking to you! Hello."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 46.19999999999999,
    "end": 48.25999999999999,
    "text": "Howard, it's Leonard, code Milky Green."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 48.329999999999984,
    "end": 49.839999999999975,
    "text": "Dear Lord, not Milky Green!"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 51.47999999999996,
    "end": 52.41999999999996,
    "text": "Affirmative, with fever."
  },
  {
    "speaker": "debbie_wolowitz",
    "start": 54.81999999999999,
    "end": 57.120000000000005,
    "text": "Who's on the phone. Why is he calling."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 55.379999999999995,
    "end": 55.76999999999998,
    "text": "It's Leonard."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 57.75,
    "end": 58.91999999999996,
    "text": "Sheldon's sick."
  },
  {
    "speaker": "debbie_wolowitz",
    "start": 59.31,
    "end": 61.349999999999966,
    "text": "Were you playing with him?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 62.81999999999999,
    "end": 66.12,
    "text": "For God's sake, Ma, I' m twenty six years old."
  },
  {
    "speaker": "debbie_wolowitz",
    "start": 66.90999999999997,
    "end": 71.29999999999995,
    "text": "Excuse me Mr Grown- up. Whadda- ya want for breakfast."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 71.78999999999996,
    "end": 73.66999999999996,
    "text": "Chocolate milk and eggoes please!"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 75.09999999999997,
    "end": 77.83999999999997,
    "text": "Howard, listen to me. No, don't, don't..."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 76.62,
    "end": 77.54999999999995,
    "text": "Hang on, call waiting."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 79.5,
    "end": 79.88,
    "text": "Hello."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 80.77999999999997,
    "end": 82.14999999999998,
    "text": "Howard, I' m sick."
  }
]