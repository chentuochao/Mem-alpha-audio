[
  {
    "speaker": "leonard_hofstadter",
    "start": 0.0,
    "end": 0.7199999999999136,
    "text": "There there."
  },
  {
    "speaker": "penny",
    "start": 5.279999999999859,
    "end": 6.67999999999995,
    "text": "God, what is wrong with me."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 6.719999999999914,
    "end": 8.209999999999923,
    "text": "Nothing, you're perfect."
  },
  {
    "speaker": "penny",
    "start": 8.529999999999859,
    "end": 9.800000000000068,
    "text": "Gah, I' m not perfect."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 9.830000000000041,
    "end": 10.669999999999959,
    "text": "Yes you are."
  },
  {
    "speaker": "penny",
    "start": 13.699999999999932,
    "end": 15.110000000000014,
    "text": "You really think so, don't you?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 20.800000000000068,
    "end": 21.159999999999968,
    "text": "Penny?"
  },
  {
    "speaker": "penny",
    "start": 26.850000000000023,
    "end": 27.209999999999923,
    "text": "Yeah."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 32.89999999999998,
    "end": 34.120000000000005,
    "text": "How much have you had to drink tonight?"
  },
  {
    "speaker": "penny",
    "start": 35.85000000000002,
    "end": 39.32000000000005,
    "text": "Just... a lot."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 41.06000000000006,
    "end": 47.06000000000006,
    "text": "Are you sure that your being drunk, and your being angry with Kurt doesn't have something to do with what's going on here?"
  },
  {
    "speaker": "penny",
    "start": 49.06000000000006,
    "end": 54.370000000000005,
    "text": "It might. Boy, you're really smart."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 54.989999999999895,
    "end": 56.370000000000005,
    "text": "Yeah, I' m a frickin' genius."
  },
  {
    "speaker": "penny",
    "start": 61.999999999999886,
    "end": 65.38999999999999,
    "text": "Leonard, you are so great. Why can't all guys be like you?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 66.78999999999985,
    "end": 69.77999999999986,
    "text": "Because if all guys were like me, the human race couldn't survive."
  }
]