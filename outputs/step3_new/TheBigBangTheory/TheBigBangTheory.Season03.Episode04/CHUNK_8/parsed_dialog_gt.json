    "text": "You are a dirty girl."
  },
  {
    "speaker": "penny",
    "start": 0.08000000000004093,
    "end": 1.259999999999991,
    "text": "Oh, God, how did he know?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 2.6000000000000227,
    "end": 3.2799999999999727,
    "text": "Hello."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 4.6200000000000045,
    "end": 5.2000000000000455,
    "text": "Hi, Howard."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 6.040000000000077,
    "end": 6.670000000000073,
    "text": "Am I interrupting?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 7.9500000000000455,
    "end": 9.399999999999977,
    "text": "Little bit, yeah."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 9.410000000000082,
    "end": 10.300000000000068,
    "text": "Guess I should have called."
  },
  {
    "speaker": "penny",
    "start": 10.480000000000018,
    "end": 11.470000000000027,
    "text": "Yeah, maybe."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 19.870000000000005,
    "end": 28.029999999999973,
    "text": "Tonight's the night I usually go line dancing with Raj at the palomino. But he's working with Sheldon."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 23.389999999999986,
    "end": 23.430000000000064,
    "text": "Uh-huh."
  },
  {
    "speaker": "penny",
    "start": 28.360000000000014,
    "end": 29.149999999999977,
    "text": "Yes, we know."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 30.340000000000032,
    "end": 31.300000000000068,
    "text": "Want me to leave?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 32.32000000000005,
    "end": 33.34000000000003,
    "text": "You know, whatever."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 34.80000000000007,
    "end": 41.83000000000004,
    "text": "Okay, I guess I can hang for a little while. So what are we watching? Sex and the city."
  },
  {
    "speaker": "penny",
    "start": 43.129999999999995,
    "end": 45.01999999999998,
    "text": "Hey, I happen to love this movie."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 45.97000000000003,
    "end": 49.55000000000007,
    "text": "Fine, let's watch it. Maybe all our periods will synchronize."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 54.31000000000006,
    "end": 60.52999999999997,
    "text": "All right, we're going to be designing an experiment to look for the annihilation spectrum resulting from dark matter collisions in space."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 61.06000000000006,
    "end": 63.389999999999986,
    "text": "Ooh, dark matter. We better bring a flashlight."
