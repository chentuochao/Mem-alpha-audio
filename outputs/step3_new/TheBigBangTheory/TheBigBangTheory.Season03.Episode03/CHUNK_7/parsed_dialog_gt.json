[
  {
    "speaker": "sheldon_cooper",
    "start": 0.0,
    "end": 0.8199999999999363,
    "text": "Bad Leonard."
  },
  {
    "speaker": "bethany",
    "start": 10.549999999999955,
    "end": 11.529999999999973,
    "text": "So what do you guys do?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 12.089999999999918,
    "end": 15.669999999999959,
    "text": "Oh, you know, goth stuff. Goth magazines, goth music."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 15.870000000000005,
    "end": 16.67999999999995,
    "text": "Goth food."
  },
  {
    "speaker": "sarah",
    "start": 17.959999999999923,
    "end": 19.069999999999936,
    "text": "What's goth food?"
  },
  {
    "speaker": "raj_koothrappali",
    "start": 20.870000000000005,
    "end": 22.819999999999936,
    "text": "Uh... blackened salmon?"
  },
  {
    "speaker": "bethany",
    "start": 24.019999999999982,
    "end": 27.25999999999999,
    "text": "No, I meant what do you do for jobs?"
  },
  {
    "speaker": "raj_koothrappali",
    "start": 27.569999999999936,
    "end": 28.699999999999932,
    "text": "Oh, we're scientists."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 28.799999999999955,
    "end": 30.92999999999995,
    "text": "Yeah, you know, the dark sciences."
  },
  {
    "speaker": "bethany",
    "start": 31.529999999999973,
    "end": 33.07999999999993,
    "text": "What are the dark sciences"
  },
  {
    "speaker": "raj_koothrappali",
    "start": 34.64999999999998,
    "end": 44.0,
    "text": "Well, I am an astrophysicist and a lot of that takes place at night. When there are vampires and miscellaneous undead out and about."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 45.219999999999914,
    "end": 46.43999999999994,
    "text": "Oy vay."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 47.65999999999997,
    "end": 50.08999999999992,
    "text": "That sounds really cool."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 51.309999999999945,
    "end": 59.33999999999992,
    "text": "Does it? Okay, if you like space stuff, I design components for the international space station. Which is in space. Where, as I'm sure you know, no one can hear you scream."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 63.18999999999994,
    "end": 64.24000000000001,
    "text": "So what do you gals do?"
  },
  {
    "speaker": "bethany",
    "start": 64.55999999999995,
    "end": 65.55999999999995,
    "text": "I work at the Gap."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 65.94999999999993,
    "end": 68.55999999999995,
    "text": "Really? How about that? I've been to the Gap."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 68.68999999999994,
    "end": 71.5,
    "text": "Yeah, I've been there as well. I like your tee-shirts with the little pocket."
  },
  {
    "speaker": "sarah",
    "start": 73.13,
    "end": 80.53999999999996,
    "text": "I work there too. Not that anyone cares. You know, this place is boring."
  },
  {
    "speaker": "bethany",
    "start": 81.80999999999995,
    "end": 84.37,
    "text": "Yeah. Why don't we go somewhere else and have some fun?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 85.30999999999995,
    "end": 85.57999999999993,
    "text": "Okay."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 86.12,
    "end": 87.12,
    "text": "Sure, we like fun."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 87.31999999999994,
    "end": 88.45999999999992,
    "text": "We are fun people."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 88.70999999999992,
    "end": 89.94999999999993,
    "text": "Dark and fun."
  },
  {
    "speaker": "bethany",
    "start": 90.05999999999995,
    "end": 92.90999999999997,
    "text": "Come on, I know a place you'll really dig."
  }
]