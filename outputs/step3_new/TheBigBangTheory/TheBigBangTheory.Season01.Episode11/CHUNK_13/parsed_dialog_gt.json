[
  {
    "speaker": "howard_wolowitz",
    "start": 0.0,
    "end": 2.5399999999999636,
    "text": "Hang on, the sensor's picking up something, turn your head back."
  },
  {
    "speaker": "penny",
    "start": 9.13000000000011,
    "end": 10.110000000000127,
    "text": "You rat bastard."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 11.950000000000045,
    "end": 13.839999999999918,
    "text": "Told you the sensor would work."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 16.09999999999991,
    "end": 16.670000000000073,
    "text": "Hi!"
  },
  {
    "speaker": "penny",
    "start": 17.329999999999927,
    "end": 19.269999999999982,
    "text": "You deliberately stuck me with Sheldon."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 19.569999999999936,
    "end": 21.720000000000027,
    "text": "Well, I had to, you see what he's like."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 21.950000000000045,
    "end": 24.15000000000009,
    "text": "Penny! Penny, I' m hungry."
  },
  {
    "speaker": "penny",
    "start": 25.019999999999982,
    "end": 30.019999999999982,
    "text": "Uh, it's okay, sweetie, good news, Leonard's home! Here you go, good luck, bye."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 28.539999999999964,
    "end": 28.700000000000045,
    "text": "No!"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 30.430000000000064,
    "end": 30.87000000000012,
    "text": "W- wait!"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 31.299999999999955,
    "end": 32.66000000000008,
    "text": "Leonard, I' m hungry!"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 33.00999999999999,
    "end": 34.83999999999992,
    "text": "Wait! Penny! Take me with you!"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 44.940000000000055,
    "end": 46.07999999999993,
    "text": "I want grilled cheese."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 64.07999999999993,
    "end": 66.81999999999994,
    "text": "Do you think Penny will come here and take care of us?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 68.67000000000007,
    "end": 71.01999999999998,
    "text": "I don't think Penny's ever coming here again."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 74.58999999999992,
    "end": 83.72000000000003,
    "text": "I' m very congested. Can you go to the kitchen, and get me the turkey baster labelled mucus."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 78.00999999999999,
    "end": 79.32999999999993,
    "text": "Yeah, so?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 87.67000000000007,
    "end": 89.53999999999996,
    "text": "If I stand, I'll vomit."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 91.18000000000006,
    "end": 92.92000000000007,
    "text": "Under the sink, yellow Tupperware bowl."
  }
]