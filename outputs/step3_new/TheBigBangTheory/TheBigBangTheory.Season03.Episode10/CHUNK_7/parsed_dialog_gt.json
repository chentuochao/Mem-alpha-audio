[
  {
    "speaker": "sheldon_cooper",
    "start": 0.0,
    "end": 3.8700000000000045,
    "text": "Project Gorilla, entry two. I am exhausted."
  },
  {
    "speaker": "bernadette_rostenkowski",
    "start": 4.600000000000023,
    "end": 8.93999999999994,
    "text": "Howard? It unhooks in the front."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 5.699999999999932,
    "end": 6.069999999999936,
    "text": "Huh?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 24.769999999999982,
    "end": 25.949999999999932,
    "text": "Oh, that explains a lot."
  },
  {
    "speaker": "debbie_wolowitz",
    "start": 27.149999999999977,
    "end": 28.93999999999994,
    "text": "Howard, I'm home!"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 30.129999999999995,
    "end": 31.329999999999927,
    "text": "Of course."
  },
  {
    "speaker": "debbie_wolowitz",
    "start": 32.51999999999998,
    "end": 45.89999999999998,
    "text": "Senior fitness was cancelled. It turns out you can forget how to ride a bike. I'm fine, but, oy, did Sam Harpootian eat gravel. What's great about an 80-year-old Armenian man with half his chin scraped off?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 45.17999999999995,
    "end": 46.45999999999992,
    "text": "That's great, Ma! No, no, don't move. Hey, Ma, can I have"
  },
  {
    "speaker": "bernadette_rostenkowski",
    "start": 45.90999999999997,
    "end": 45.92999999999995,
    "text": "I guess I should go."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 52.76999999999998,
    "end": 53.129999999999995,
    "text": "lamb"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 59.44999999999993,
    "end": 60.23000000000002,
    "text": "stew for dinner?"
  },
  {
    "speaker": "debbie_wolowitz",
    "start": 60.549999999999955,
    "end": 63.069999999999936,
    "text": "Lamb stew? I'd have to go to the supermarket."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 64.51999999999998,
    "end": 66.78999999999996,
    "text": "Please? I got a real hankering."
  }
]