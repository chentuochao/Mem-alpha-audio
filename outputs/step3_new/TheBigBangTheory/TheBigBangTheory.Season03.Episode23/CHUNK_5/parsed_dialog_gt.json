[
  {
    "speaker": "leonard_hofstadter",
    "start": 0.0,
    "end": 0.36000000000001364,
    "text": "Coming!"
  },
  {
    "speaker": "penny",
    "start": 5.829999999999984,
    "end": 7.3799999999999955,
    "text": "Damn you, you rat bastard."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 8.0,
    "end": 8.939999999999998,
    "text": "Are you drunk?"
  },
  {
    "speaker": "penny",
    "start": 9.560000000000002,
    "end": 12.980000000000018,
    "text": "Zack was a perfectly nice guy, and then you ruined him!"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 13.599999999999966,
    "end": 15.159999999999968,
    "text": "How did I ruin him?"
  },
  {
    "speaker": "penny",
    "start": 15.199999999999989,
    "end": 18.50999999999999,
    "text": "Cause in the olden days, I never would've known he was so stupid."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 22.339999999999975,
    "end": 24.0,
    "text": "Come on, he wasn't that stupid."
  },
  {
    "speaker": "penny",
    "start": 24.569999999999993,
    "end": 28.30000000000001,
    "text": "Yes, he was! He thought you were gonna blow up the moon!"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 28.870000000000005,
    "end": 30.269999999999982,
    "text": "Okay, yeah, he's stupid."
  },
  {
    "speaker": "penny",
    "start": 31.019999999999982,
    "end": 35.389999999999986,
    "text": "He spent the entire night bragging about how he invented the word appe-teasers."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 40.339999999999975,
    "end": 41.620000000000005,
    "text": "How is that my fault?"
  },
  {
    "speaker": "penny",
    "start": 42.02999999999997,
    "end": 45.99000000000001,
    "text": "You have destroyed my ability to tolerate idiots. Now, come with me."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 46.31999999999999,
    "end": 47.02999999999997,
    "text": "Where are we going?"
  },
  {
    "speaker": "penny",
    "start": 47.839999999999975,
    "end": 49.44999999999999,
    "text": "We're gonna have sex."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 50.25999999999999,
    "end": 52.27999999999997,
    "text": "Why? I mean, okay."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 53.089999999999975,
    "end": 54.06999999999999,
    "text": "What's going on?"
  },
  {
    "speaker": "penny",
    "start": 54.31,
    "end": 57.31999999999999,
    "text": "Put on your noise-cancelling headphones,'cause it's gonna get loud."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 58.920000000000016,
    "end": 61.829999999999984,
    "text": "Oh! Not this again."
  }
]