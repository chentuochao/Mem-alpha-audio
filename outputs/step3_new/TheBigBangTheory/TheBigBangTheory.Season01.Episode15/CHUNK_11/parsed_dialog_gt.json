[
  {
    "speaker": "howard_wolowitz",
    "start": 0.0,
    "end": 1.0299999999999727,
    "text": "come on, get up."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 1.169999999999959,
    "end": 1.3999999999999773,
    "text": "Stay down,"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 7.639999999999986,
    "end": 9.759999999999991,
    "text": "bitch. Yeah, ha ha, natural selection at work."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 9.950000000000045,
    "end": 11.110000000000014,
    "text": "I weep for humanity."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 12.509999999999991,
    "end": 14.370000000000005,
    "text": "Excuse me while I go tell Missy the good news."
  },
  {
    "speaker": "penny",
    "start": 21.42999999999995,
    "end": 22.25999999999999,
    "text": "Ah, hey Leonard."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 22.600000000000023,
    "end": 29.539999999999964,
    "text": "Hi Penny, how's it going. Listen, that guy Mike that you were dating, is that still going on? Nothing, just catching up. By the way, may I speak to Missy please?"
  },
  {
    "speaker": "penny",
    "start": 26.090000000000032,
    "end": 26.960000000000036,
    "text": "Uh, pretty much, why?"
  },
  {
    "speaker": "penny",
    "start": 30.99000000000001,
    "end": 32.43999999999994,
    "text": "Of course."
  },
  {
    "speaker": "missy_cooper",
    "start": 33.889999999999986,
    "end": 35.23000000000002,
    "text": "Hi, Leonard, what's up?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 35.43999999999994,
    "end": 38.84000000000003,
    "text": "Well, since you're leaving tomorrow I was wondering if you'd like to go out to dinner with me?"
  },
  {
    "speaker": "missy_cooper",
    "start": 39.469999999999914,
    "end": 41.879999999999995,
    "text": "That's so sweet. But no thanks."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 43.520000000000095,
    "end": 46.16999999999996,
    "text": "Oh. You have other plans, or...?"
  },
  {
    "speaker": "missy_cooper",
    "start": 46.229999999999905,
    "end": 46.44999999999993,
    "text": "No."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 48.69999999999993,
    "end": 49.06000000000006,
    "text": "Oh."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 50.93999999999994,
    "end": 54.64999999999998,
    "text": "Alright uh... enjoy the rest of your evening."
  },
  {
    "speaker": "missy_cooper",
    "start": 55.360000000000014,
    "end": 56.31000000000006,
    "text": "Thanks. See you."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 63.479999999999905,
    "end": 65.56000000000006,
    "text": "Um, here's something we didn't anticipate."
  },
  {
    "speaker": "penny",
    "start": 67.35000000000002,
    "end": 71.84000000000003,
    "text": "What do you want, Howard?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 73.63,
    "end": 78.19999999999993,
    "text": "I' m fine, thanks for asking. I' ve come to call on Missy."
  },
  {
    "speaker": "penny",
    "start": 78.24999999999989,
    "end": 78.62,
    "text": "Missy?"
  }
]