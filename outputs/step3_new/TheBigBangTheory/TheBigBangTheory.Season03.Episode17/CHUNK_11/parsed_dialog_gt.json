[
  {
    "speaker": "sheldon_cooper",
    "start": 0.0,
    "end": 0.8700000000000045,
    "text": "I don't want to hear this."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 0.9900000000000091,
    "end": 3.740000000000009,
    "text": "Then let go of the ring and walk away."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 4.230000000000018,
    "end": 4.920000000000073,
    "text": "Never."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 5.940000000000055,
    "end": 12.550000000000068,
    "text": "All right. I'll bet your Meemaw didn't just have sex to have your mother. I bet she had sex because she liked it."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 15.600000000000023,
    "end": 16.180000000000064,
    "text": "Stop it!"
  },
  {
    "speaker": "raj_koothrappali",
    "start": 16.220000000000027,
    "end": 17.680000000000064,
    "text": "Yeah, Meemaw did the nasty."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 18.430000000000064,
    "end": 19.920000000000073,
    "text": "I said stop it!"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 20.660000000000082,
    "end": 21.220000000000027,
    "text": "We're getting to him."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 21.470000000000027,
    "end": 25.850000000000023,
    "text": "Waterfalls! Waterfalls. Crashing waves. Babbling brooks."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 22.520000000000095,
    "end": 22.800000000000068,
    "text": "What?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 28.49000000000001,
    "end": 29.110000000000014,
    "text": "What are you doing?"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 29.210000000000036,
    "end": 38.370000000000005,
    "text": "Subliminal messaging. I'm going to make you want to pee. Dripping faucets. Leaky gutter. Peeing."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 40.15000000000009,
    "end": 41.33000000000004,
    "text": "It's, it's not working, dude."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 41.860000000000014,
    "end": 45.42000000000007,
    "text": "Oh-ho-ho, it's working all right. I have to pee."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 46.97000000000003,
    "end": 48.440000000000055,
    "text": "Then let go of the ring and go."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 48.60000000000002,
    "end": 49.91000000000008,
    "text": "No, actually, I wouldn't mind going, too."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 51.74000000000001,
    "end": 55.04000000000008,
    "text": "Fine. Um, on the count of three. One, two..."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 55.30000000000007,
    "end": 59.930000000000064,
    "text": "Wait, just to clarify. When you get to three, do we stand up or do we pee?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 63.520000000000095,
    "end": 64.45000000000005,
    "text": "We stand up."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 65.71000000000004,
    "end": 66.5200000000001,
    "text": "Excellent choice."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 67.49000000000001,
    "end": 67.98000000000002,
    "text": "Three."
  }
]