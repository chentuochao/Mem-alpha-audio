[
  {
    "speaker": "leonard_hofstadter",
    "start": 0.0,
    "end": 3.7799999999999727,
    "text": "Terrific. Hey."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 6.839999999999918,
    "end": 7.2000000000000455,
    "text": "Hey."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 10.259999999999991,
    "end": 10.620000000000118,
    "text": "Hey."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 13.319999999999936,
    "end": 14.230000000000018,
    "text": "Nice sweater."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 16.15000000000009,
    "end": 18.700000000000045,
    "text": "Yeah, Stephanie got it for me. It's kind of fun."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 19.269999999999982,
    "end": 20.90000000000009,
    "text": "It's got a big bird on it, dude."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 22.910000000000082,
    "end": 37.13000000000011,
    "text": "Yeah, yeah, that's the fun part. We're also getting new curtains for my bedroom, and a dust ruffle, and a duvet, and I don't even know what a duvet is but I'm pretty sure if I did I wouldn't want one, but every time I talk to her about moving out she cries and we have sex."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 38.960000000000036,
    "end": 41.049999999999955,
    "text": "You're lucky. With me, it's usually the other way around."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 43.62000000000012,
    "end": 45.940000000000055,
    "text": "You know, if you can't talk to her, why don't you just text her?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 46.67000000000007,
    "end": 47.92000000000007,
    "text": "Isn't that kind of cowardly?"
  },
  {
    "speaker": "howard_wolowitz",
    "start": 48.08999999999992,
    "end": 49.38000000000011,
    "text": "Oh, yeah. It's beyond contemptible."
  },
  {
    "speaker": "raj_koothrappali",
    "start": 50.87000000000012,
    "end": 53.23000000000002,
    "text": "It's true, but on the other hand you are wearing a bird sweater."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 57.73000000000002,
    "end": 72.74000000000001,
    "text": "Sold.\" I think it would be better for our relationship if you moved back to your place.\" There. It's done."
  },
  {
    "speaker": "howard_wolowitz",
    "start": 73.32999999999993,
    "end": 73.96000000000004,
    "text": "Good for you."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 74.74000000000001,
    "end": 78.94000000000005,
    "text": "Yeah, good for me. I'll never have sex again."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 85.77999999999997,
    "end": 86.8599999999999,
    "text": "I was wrong."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 93.70000000000005,
    "end": 94.28999999999996,
    "text": "See ya."
  },
  {
    "speaker": "penny",
    "start": 105.25,
    "end": 105.90000000000009,
    "text": "Sheldon?"
  },
  {
    "speaker": "computer_voice#unknown#TheBigBangTheory.Season02.Episode10",
    "start": 109.04999999999995,
    "end": 111.72000000000003,
    "text": "I have an inflamed larynx."
  },
  {
    "speaker": "penny",
    "start": 119.04999999999995,
    "end": 119.12000000000012,
    "text": "Okay?"
  },
  {
    "speaker": "computer_voice#unknown#TheBigBangTheory.Season02.Episode10",
    "start": 119.25,
    "end": 122.51999999999998,
    "text": "We're out of herbal tea. Do you have any?"
  },
  {
    "speaker": "penny",
    "start": 126.55999999999995,
    "end": 127.78999999999996,
    "text": "Okay, let me check."
  },
  {
    "speaker": "computer_voice#unknown#TheBigBangTheory.Season02.Episode10",
    "start": 131.54999999999995,
    "end": 134.4000000000001,
    "text": "Some hiney would be nice, too."
  },
  {
    "speaker": "penny",
    "start": 137.48000000000002,
    "end": 137.8499999999999,
    "text": "Hiney?"
  },
  {
    "speaker": "computer_voice#unknown#TheBigBangTheory.Season02.Episode10",
    "start": 140.93000000000006,
    "end": 141.54999999999995,
    "text": "Honey."
  }
