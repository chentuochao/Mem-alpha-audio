[
  {
    "speaker": "sheldon_cooper",
    "start": 0.0,
    "end": 0.36000000000001364,
    "text": "Leonard!"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 5.75,
    "end": 6.110000000000014,
    "text": "Leonard!"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 11.5,
    "end": 22.870000000000005,
    "text": "Leonard. Leonard, my comforter fell down, and my sinuses hurt when I bend over. Leonard?"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 30.78000000000003,
    "end": 31.220000000000027,
    "text": "Ow!"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 34.80000000000001,
    "end": 35.160000000000025,
    "text": "Hey."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 38.75,
    "end": 40.31,
    "text": "Leonard, where are you?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 40.74000000000001,
    "end": 41.400000000000034,
    "text": "I' m at work."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 43.14000000000004,
    "end": 51.60000000000002,
    "text": "At six- thirty in the morning? On Sunday? Why?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 45.650000000000034,
    "end": 46.160000000000025,
    "text": "Yes."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 49.420000000000016,
    "end": 49.98000000000002,
    "text": "Yes."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 51.670000000000016,
    "end": 52.660000000000025,
    "text": "They asked me to come in."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 53.28000000000003,
    "end": 54.660000000000025,
    "text": "Well, I didn't hear the phone ring."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 55.31,
    "end": 56.210000000000036,
    "text": "They texted me."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 58.09000000000003,
    "end": 67.57000000000005,
    "text": "Well, as I predicted, I am sick. My fever has been tracking up exponentially since 2 am, and I am producing sputum at an alarming rate."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 70.33000000000004,
    "end": 71.38,
    "text": "No kidding?"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 71.62,
    "end": 75.85000000000002,
    "text": "No. Not only that, it has shifted from clear to milky green."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 75.89000000000004,
    "end": 80.01000000000005,
    "text": "Alright, well, get some rest and drink plenty of fluids."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 80.21000000000004,
    "end": 84.16000000000003,
    "text": "What else would I drink? Gasses? Solids? Ionised plasma?"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 85.66000000000003,
    "end": 89.18,
    "text": "Drink whatever you want. Then make soup."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 87.12,
    "end": 90.12,
    "text": "I want soup. We don't have soup."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 90.72000000000003,
    "end": 92.05000000000001,
    "text": "I' m at work, Sheldon."
  }
]