[
  {
    "speaker": "sheldon_cooper",
    "start": 0.0,
    "end": 4.439999999999827,
    "text": "All I need is a healthy ovum and I can grow my own Leonard Nimoy!"
  },
  {
    "speaker": "penny",
    "start": 6.069999999999936,
    "end": 13.429999999999836,
    "text": "Okay, all I'm giving you is the napkin, Sheldon."
  },
  {
    "speaker": "sheldon_cooper",
    "start": 15.059999999999945,
    "end": 15.569999999999936,
    "text": "Be right back."
  },
  {
    "speaker": "penny",
    "start": 19.12999999999988,
    "end": 19.829999999999927,
    "text": "Here. Open it."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 24.049999999999955,
    "end": 31.279999999999973,
    "text": "Oh, a gift certificate for motorcycle lessons. Very thoughtful."
  },
  {
    "speaker": "penny",
    "start": 31.569999999999936,
    "end": 35.27999999999997,
    "text": "Yeah, and I checked. Not letting the bike fall on you while standing still is lesson one."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 35.27999999999997,
    "end": 35.669999999999845,
    "text": "Oh,"
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 37.77999999999997,
    "end": 39.669999999999845,
    "text": "then, I think you'll appreciate what I got you."
  },
  {
    "speaker": "penny",
    "start": 40.22000000000003,
    "end": 40.58999999999992,
    "text": "Okay."
  },
  {
    "speaker": "penny",
    "start": 45.200000000000045,
    "end": 48.299999999999955,
    "text": "101 Totally Cool Science Experiments for Kids."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 53.319999999999936,
    "end": 54.789999999999964,
    "text": "You know,'cause you're so into science."
  },
  {
    "speaker": "penny",
    "start": 58.63999999999987,
    "end": 63.929999999999836,
    "text": "Sheldon! What did you do?!"
  },
  {
    "speaker": "sheldon_cooper",
    "start": 67.76999999999998,
    "end": 78.26999999999998,
    "text": "I know! It's not enough, is it? Here."
  },
  {
    "speaker": "penny",
    "start": 83.20000000000005,
    "end": 89.57999999999993,
    "text": "Leonard, look! Sheldon's hugging me."
  },
  {
    "speaker": "leonard_hofstadter",
    "start": 94.51999999999998,
    "end": 96.17999999999984,
    "text": "It's a Saturnalia miracle."
  }
]